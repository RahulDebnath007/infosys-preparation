def solve():
    n = int(input())
    k = int(input())
    x = [int(input()) for _ in range(n)]

    if k == 1:
        print(max(x))
        return

    def possible(T):
        required = 0

        for value in x:
            if value > T:
                need = (value - T + (k - 2)) // (k - 1)
                required += need

                if required > T:
                    return False

        return required <= T

    low = 0
    high = max(x)

    while low < high:
        mid = (low + high) // 2

        if possible(mid):
            high = mid
        else:
            low = mid + 1

    print(low)


solve()